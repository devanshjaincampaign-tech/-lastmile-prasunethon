# Get a free Gemini API key (no credit card) at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use. Google's model lineup changes fast — if this model
# returns a 404, go to https://aistudio.google.com/, check "Models" in the
# left sidebar for the current free-tier Flash model name, and paste it here.
# Known-good candidates as of mid-2026: gemini-2.5-flash, gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.6-flash

# Port the Express server runs on locally
PORT=5000

# Comma-separated list of allowed frontend origins (for CORS)
# For local dev, the Vite default is http://localhost:5173
# Add your deployed Vercel URL here once you have it, e.g. https://lastmile.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
