# Create a free Firebase project at https://console.firebase.google.com
# Then: Project settings (gear icon) -> General -> "Your apps" -> Add a Web app
# Copy the config values it gives you into these fields.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Also in the Firebase Console: enable "Anonymous" sign-in under
# Authentication -> Sign-in method, and create a Firestore database
# (Build -> Firestore Database -> Create database, start in test mode).
# Firebase Storage is NOT needed — it requires the paid Blaze plan, so this
# app stores compressed doubt photos directly inside Firestore documents.
# VITE_FIREBASE_STORAGE_BUCKET below can be left blank.

# URL of your locally running or deployed backend
VITE_API_BASE_URL=http://localhost:5000